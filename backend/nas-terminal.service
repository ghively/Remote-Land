[Unit]
Description=NAS Terminal Backend Agent
After=network.target docker.service

[Service]
Type=simple
# Set User to the account that owns the checkout on your box, then adjust
# WorkingDirectory if the repo isn't cloned directly into that user's home
# directory. %h expands to the home directory of the User below.
User=remoteland
WorkingDirectory=%h/remote-land/backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
